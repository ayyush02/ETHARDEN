pragma solidity ^0.8.24;

/**
 * @title IGardenChild
 * @notice Standard interface that every child protocol deployed by the Autonomous Protocol Garden must implement.
 * @dev Enforces revenue sharing with the Garden, performance metric reporting, and Garden-controlled lifecycle.
 */
interface IGardenChild {
    // ==========================================
    // Events
    // ==========================================

    /// @notice Emitted whenever revenue is generated and shared with the Garden
    event RevenueShared(address indexed token, uint256 totalFee, uint256 gardenShare, uint256 protocolShare);

    /// @notice Emitted when revenue is withdrawn/harvested by or pushed to the Garden
    event RevenueHarvested(address indexed token, uint256 amount);

    /// @notice Emitted when child is paused by the Garden
    event ChildPaused(address indexed garden);

    /// @notice Emitted when child is unpaused by the Garden
    event ChildUnpaused(address indexed garden);

    /// @notice Emitted when child is permanently sunset and funds are reclaimed
    event ChildSunset(address indexed garden, address indexed tokenReclaimed, uint256 amountReclaimed);

    // ==========================================
    // View Functions
    // ==========================================

    /// @notice Address of the parent GardenCore contract
    function garden() external view returns (address);

    /// @notice Unique protocol type identifier (e.g., keccak256("SIMPLE_AMM"))
    function childType() external view returns (bytes32);

    /// @notice Revenue share basis points owed to the Garden (e.g. 2000 = 20%)
    function feeShareBps() external view returns (uint16);

    /// @notice Total cumulative fees generated by this child protocol for a given token
    function totalFeesGenerated(address token) external view returns (uint256);

    /// @notice Total cumulative fees paid to the Garden core treasury for a given token
    function totalFeesPaidToGarden(address token) external view returns (uint256);

    /// @notice Total transaction volume processed by this child protocol for a given token
    function totalVolume(address token) external view returns (uint256);

    /// @notice Accrued fees waiting to be harvested by the Garden
    function accruedGardenFees(address token) external view returns (uint256);

    /// @notice Seed capital provided at genesis by the Garden
    function seedCapitalReceived(address token) external view returns (uint256);

    /// @notice Returns true if the child protocol is currently active and accepting user interactions
    function isActive() external view returns (bool);

    /// @notice Returns true if the child protocol has been sunset
    function isSunset() external view returns (bool);

    // ==========================================
    // State-Changing Functions
    // ==========================================

    /**
     * @notice Harvests accrued fees for a given token and transfers them to the Garden treasury.
     * @param token The address of the token (or address(0) for native ETH).
     * @return amountHarvested The amount of fees transferred to the Garden.
     */
    function harvestRevenue(address token) external returns (uint256 amountHarvested);

    /**
     * @notice Emergency pauses child protocol interactions. Can only be invoked by the Garden.
     */
    function emergencyPause() external;

    /**
     * @notice Unpauses child protocol interactions. Can only be invoked by the Garden.
     */
    function emergencyUnpause() external;

    /**
     * @notice Sunsets the child protocol, liquidates remaining liquidity, and returns all capital to the Garden.
     * @dev Can only be invoked by the Garden core contract.
     * @param primaryToken The token to liquidate and return to Garden (address(0) for ETH).
     * @return reclaimedAmount The total balance returned to the Garden treasury.
     */
    function sunset(address primaryToken) external returns (uint256 reclaimedAmount);
}
